# Pavver environment template.
# Copy to .env (gitignored) and fill in real values before running expo commands.
#
#   cp .env.example .env
#   # then edit .env

# Mapbox — https://account.mapbox.com
# Public token (used at runtime to render maps). Starts with "pk.".
MAPBOX_PUBLIC_TOKEN=

# Downloads token (used during native build to fetch the Mapbox SDK).
# Create a NEW secret token with the `Downloads:Read` scope. Starts with "sk.".
# Required for Android prebuild; missing it makes the native build fail.
MAPBOX_DOWNLOADS_TOKEN=

# Firebase — https://console.firebase.google.com
# Project ID (not the API key). Found under Project Settings → General.
FIREBASE_PROJECT_ID=

# OAuth 2.0 Web Client ID for Google sign-in. Found under Firebase Console →
# Authentication → Sign-in method → Google → "Web SDK configuration". Looks like
# 1234567890-abcdef1234567890.apps.googleusercontent.com.
# Used by GoogleSignin.configure() so the native Google flow returns a Firebase-
# compatible idToken.
FIREBASE_WEB_CLIENT_ID=

# iOS reverse-client URL scheme for Google Sign-In. Open your
# GoogleService-Info.plist and copy the value of `REVERSED_CLIENT_ID`. Looks like
# com.googleusercontent.apps.1234567890-abcdef. Required so the iOS SDK can handle
# the OAuth callback when Google's web view redirects back to the app.
GOOGLE_IOS_URL_SCHEME=

# Optional overrides for the platform Firebase config files. By default they're
# expected at the repo root (./GoogleService-Info.plist and ./google-services.json),
# both gitignored. Set these if you keep the files elsewhere.
# GOOGLE_SERVICES_INFO_PLIST=./GoogleService-Info.plist
# GOOGLE_SERVICES_JSON=./google-services.json
